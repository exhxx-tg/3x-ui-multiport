# ──────────────────────────────────────────────
# X-UI PRO - .gitignore
# ──────────────────────────────────────────────

# IDE & Editor
.idea/
.vscode/
.cursor/
.claude/
.cache/
.sync*
*.swp
*.swo
*~
*.orig

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Logs
*.log
logs/
access.log
error.log

# Temp files
tmp/
*.tar.gz
*.zip
*.bak

# Build & Distribution
backup/
bin/
x-ui/
dist/
!internal/web/dist/
internal/web/dist/*
!internal/web/dist/.gitkeep
release/
node_modules/
build/

# Go
main
*.exe
*.o
*.a
*.so
vendor/
go.sum

# Database
x-ui.db
x-ui.db-shm
x-ui.db-wal
system_metrics.gob
*.dump
*.db
*.sqlite
*.sqlite3

# Environment
.env
.env.local
.env.*.local
.env.example

# Docker
docker-compose.override.yml

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml

# Python (for scripts)
__pycache__/
*.py[cod]
*$py.class

# Certificates (generated)
*.pem
*.key
*.crt
*.cert
certs/

# Secrets
secrets/
!secrets/.gitkeep

